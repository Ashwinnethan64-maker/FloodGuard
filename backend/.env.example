# NEERPATH Backend Environment Configuration (Template)

# Database Configuration (Supabase / PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neerpath

# Supabase Integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here
SUPABASE_KEY=sb_secret_your_service_role_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://floodguard.vercel.app,https://*.vercel.app

# Weather API (Open-Meteo is free without API key, key optional for commercial tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEZONE=auto
OPEN_METEO_FORECAST_DAYS=7

# Routing Engine (HeiGIT / OpenRouteService Directions v2)
ORS_API_KEY=your_heigit_openrouteservice_jwt_token_here
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# Google Gemini AI Integration (Strictly backend only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Admin SDK (Keep secret on backend only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mangaluru Coordinates Baseline
MANGALURU_LAT=12.9141
MANGALURU_LON=74.8560
