# NEERPATH Frontend Environment Configuration (Template)
VITE_API_BASE_URL=http://localhost:8000/api

# OpenStreetMap Basemap Configuration
# Uses standard open tile servers with proper attribution; no API key required

# Supabase Client Configuration (Public/Anon Key Only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_pair_here

# Baseline Mangaluru Coordinates
VITE_MANGALURU_LAT=12.9141
VITE_MANGALURU_LON=74.8560
